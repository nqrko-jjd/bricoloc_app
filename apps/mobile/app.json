{
  "expo": {
    "name": "BRICOLOC",
    "slug": "bricoloc",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bricoloc",
    "userInterfaceStyle": "light",
    "primaryColor": "#E52421",
    "splash": {
      "backgroundColor": "#0B1D3A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bricoloc.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bricoloc.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1D3A"
      }
    },
    "plugins": ["expo-router", "expo-notifications"],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "http://localhost:4000"
    }
  }
}
