{
  "expo": {
    "name": "BRICOLOC",
    "slug": "bricoloc",
    "owner": "jjd-consult",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "bricoloc",
    "userInterfaceStyle": "light",
    "primaryColor": "#EE2C24",
    "splash": {
      "backgroundColor": "#0B1D3A",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bricoloc.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bricoloc.app",
      "adaptiveIcon": {
        "backgroundColor": "#0B1D3A"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-localization",
      [
        "expo-camera",
        {
          "cameraPermission": "BRICOLOC utilise la caméra pour scanner les QR codes de vos réservations et les étiquettes des machines."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "BRICOLOC utilise la caméra pour photographier l'état du matériel à la sortie et au retour."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://new.bricoloc.be/bricoloc-api",
      "teamMode": false,
      "router": {},
      "eas": {
        "projectId": "c4f91fbb-5b17-4cc1-8940-28117766ac77"
      }
    }
  }
}
