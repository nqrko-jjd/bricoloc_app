{
  "name": "@bricoloc/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push --skip-generate --accept-data-loss",
    "db:reset": "prisma db push --force-reset --skip-generate --accept-data-loss && npm run seed",
    "seed": "tsx prisma/seed.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx --experimental-test-isolation=none src/**/*.test.ts test/**/*.test.ts"
  },
  "dependencies": {
    "@bricoloc/shared": "*",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nanoid": "^3.3.8",
    "pdfkit": "^0.15.2",
    "qrcode": "^1.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.13.9",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
