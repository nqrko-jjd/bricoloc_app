# Copier vers .env (fait automatiquement par "npm run setup")
DATABASE_URL="file:./dev.db"
JWT_SECRET="dev-bricoloc-secret-change-me"
PORT=4000
# URL publique de l'API, utilisee dans les QR / liens de factures
PUBLIC_API_URL="http://localhost:4000"
# URL publique du site (canonical / hreflang / liens e-mail)
SITE_URL="https://www.bricoloc.be"
# Origines autorisees (web, borne, Expo). * en dev.
CORS_ORIGINS="*"
# Envoi reel des push Expo (false = simulation loggee)
EXPO_PUSH_ENABLED="false"

# Cle API DeepL pour l auto-traduction (https://www.deepl.com/pro-api). Format: xxxx-xxxx-...:fx
DEEPL_API_KEY=""

# Paiement Mollie (vide = mock). Cle test_... = mode test.
MOLLIE_API_KEY=
