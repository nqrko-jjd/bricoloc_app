# ─────────────────────────────────────────────────────────────────────────────
#  BRICOLOC — configuration de production
#  Copier vers  .env.production  à la racine, puis compléter.
#  Ne jamais committer le fichier rempli.
# ─────────────────────────────────────────────────────────────────────────────

# Domaine public qui sert le site + l'API + les médias.
# Phase de test : un sous-domaine dédié.  Bascule finale : www.bricoloc.be
DOMAIN=new.bricoloc.be
SITE_URL=https://new.bricoloc.be

# E-mail pour Let's Encrypt (alertes d'expiration).
CERTBOT_EMAIL=david@jjd-consult.be
# 1 = certificats de test (quota illimité) pendant la mise au point, 0 = réels.
CERTBOT_STAGING=0

# Base de données PostgreSQL (interne au réseau Docker).
POSTGRES_USER=bricoloc
POSTGRES_PASSWORD=CHANGER_ce_mot_de_passe_long
POSTGRES_DB=bricoloc

# Secret de signature des jetons (générer : openssl rand -hex 32).
JWT_SECRET=CHANGER_par_une_valeur_aleatoire_de_64_caracteres

# Traduction automatique NL/EN (déjà utilisée en dev). Laisser vide pour désactiver.
DEEPL_API_KEY=

# Notifications push de l'app mobile (laisser false tant que l'app n'est pas publiée).
EXPO_PUSH_ENABLED=false

# ─── Paiement Mollie ───
# Vide = paiement mock (démo). Clé « test_… » = mode test (pas de vrai argent).
# Clé « live_… » = production.
MOLLIE_API_KEY=
# Webhook : dérivé de SITE_URL par défaut. À forcer seulement si besoin.
# MOLLIE_WEBHOOK_URL=https://new.bricoloc.be/bricoloc-api/api/checkout/mollie/webhook

# ─── API partenaire — parc partagé JJD ───
# Clé partagée avec le CRM JJD pour la gestion du parc commun (sorties chantier,
# consommables). Vide = API partenaire désactivée.
# Générer (PowerShell) : -join ((1..32)|%{ '{0:x2}' -f (Get-Random -Max 256) })
PARTNER_API_KEY=
